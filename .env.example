# ─────────────────────────────────────────────────────────────
# Waver 환경변수 템플릿
# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.
#   cp .env.example .env
# .env 는 git 에 커밋되지 않는다(.gitignore). 운영은 시스템 환경변수로 주입.
# ─────────────────────────────────────────────────────────────

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/bucket
DB_USERNAME=root
DB_PASSWORD=change-me

# --- JWT ---
# 토큰 서명 키(길고 무작위인 문자열). 반드시 교체.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# --- Google Cloud / Pub/Sub (구독 RTDN) ---
GCP_PROJECT_ID=waver-478413
# 서비스 계정 키 파일 위치. classpath: 또는 file: 접두어 사용.
#   로컬 예: classpath:google-api-key.json
#   운영 예: file:/home/opc/google-api-key.json
GCP_CREDENTIALS_LOCATION=classpath:google-api-key.json
PLAY_RTDN_SUBSCRIPTION_ID=play-rtdn-topic-sub

# --- Google Play (구매 검증) ---
#   로컬 예: src/main/resources/google-api-key.json
#   운영 예: /home/opc/google-api-key.json
GOOGLE_PLAY_CREDENTIALS_PATH=src/main/resources/google-api-key.json
GOOGLE_PLAY_PACKAGE_NAME=com.zinc.waver

# --- Waver 서비스 계정 키 (FCM 등) ---
#   로컬 예: src/main/resources/waver-service-account.json
#   운영 예: /home/opc/waver-service-account.json
WAVER_SERVICE_KEY_PATH=src/main/resources/waver-service-account.json

# --- 파일 업로드/정적 리소스 ---
FILE_UPLOAD_PATH=upload
FILE_STATICS_PATH=http://localhost:8080/images
